# Local Development Environment Variables
# Copy this file to .env.local and fill in your values
# .env.local is NEVER committed to git (see .gitignore)

# Firebase Project Configuration
FIREBASE_PROJECT_ID=ludus-firestore
FIREBASE_STORAGE_BUCKET=ludus-firestore.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
FIREBASE_APP_ID=your-app-id-here

# Service Account (local development only)
# Download from Firebase Console → Project Settings → Service Accounts
# KEEP THIS SECURE — Never commit this file with real credentials
# Path: ~/.firebase/ludus-firestore-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=~/.firebase/ludus-firestore-service-account.json

# Development/Production Flag
NODE_ENV=development

# Logging Level (debug | info | warn | error)
LOG_LEVEL=debug

# Optional: Local Firebase Emulator (for testing without cloud)
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
