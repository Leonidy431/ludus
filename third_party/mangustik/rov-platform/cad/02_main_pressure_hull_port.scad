// ==========================================
// DIVEGUARD: Main Pressure Hull Port (02)
// Material: Anodized Aluminum 6061-T6[cite: 2]
// Depth Rating: 300m[cite: 2, 3]
// ==========================================

$fn = 120;

module pressure_hull_port() {
    // 1. Основной цилиндрический корпус (труба)
    difference() {
        cylinder(h = 800, r = 100, center = false);
        translate([0, 0, -1])
            cylinder(h = 802, r = 90, center = false);
    }

    // 2. Передняя торцевая крышка с прозрачным окном / интерфейсом камеры
    // HARDWARE_AUDIT_2026-08-28 #17: цилиндр Ø80 «под иллюминатор» был
    // в union() — он ДОБАВЛЯЛ сплошной пруток вместо выреза, крышка была
    // глухой (задняя крышка ниже делает это правильно через difference()).
    color("Silver")
    translate([0, 0, -30])
        difference() {
            union() {
                cylinder(h = 30, r = 99.7, center = false);
                translate([0, 0, 30])
                    cylinder(h = 15, r = 89.8, center = false);
            }
            // Центральное отверстие под оптический иллюминатор — сквозное
            translate([0, 0, -1])
                cylinder(h = 47, r = 40);
        }

    // 3. Задняя крышка с коммуникационными разъемами (Ethernet, гидрофон, сонар)
    color("Silver") 
    translate([0, 0, 800]) {
        difference() {
            cylinder(h = 35, r = 99.7, center = false);
            // Панель под сигнальные и интерфейсные герморазъемы SubConn
            for (i = [0 : 5]) {
                rotate([0, 0, i * 60])
                translate([55, 0, -1])
                    cylinder(h = 40, r = 5); // Отверстия под сигнальные пенетраторы
            }
        }
    }

    // 4. Внутренний выдвижной слайдер (каркас плат вычислителя)
    //
    // Fixed 2026-08-08: was a solid cube([140,140,740]) unioned into the hull -
    // ~14.5kg of dead aluminum filling almost the entire sensor bay, leaving no room
    // for actual electronics/cabling and contradicting both HLD.md's own stated intent
    // ("mounting guides for PCBs in slider form", item 8 of the original plan) and this
    // hull's own sibling file (03_main_pressure_hull_starboard.scad), whose equivalent
    // battery-slider feature is correctly modeled as a thin intersection()-based rail
    // frame, not a solid block. Found via compute_part_masses.py: port hull's computed
    // mass (55.8kg) was ~2.7x starboard's (20.6kg) despite HLD.md stating both hulls are
    // "same tube stock" - the discrepancy traced directly to this one feature. Real exact
    // PCB card-rail dimensions are not yet sourced (same class of open item as the rest
    // of Phase 1/2's unmet DoD), so this mirrors the starboard hull's established
    // intersection() pattern rather than inventing new numbers - a real fix consistent
    // with existing evidence in this repo, not a guess at final rail geometry.
    // HARDWARE_AUDIT_2026-08-28 #18: оба примитива были center=true и
    // после сдвига +30 рельс занимал z −340..+400 — 340 мм торчали сквозь
    // переднюю крышку наружу. Теперь рельс целиком внутри корпуса, 30..770.
    color("DarkSlateGray")
    translate([0, 0, 30])
        intersection() {
            cylinder(h = 740, r = 89, center = false);
            translate([0, 0, 370])
                cube([100, 10, 740], center = true);
        }
}

pressure_hull_port();

