--!strict
--[[
	ReportService.luau — Фаза 1, шаг 1: "Сбор отчётов".

	A Report is generated by spending Ludus energy at a named region. The
	denier value scales with the player's total relic power, which is the
	first (and gentlest) way the gacha loop feeds the collection loop.

	Reports are also held as flavour items (capped) and can be "submitted"
	for a bonus — this gives the 15-minute session a natural cadence:
	collect until the satchel is heavy, submit, roll, defend.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Types = require(Shared.Types)

local Server = script.Parent
local Guard = require(Server.Guard)
local EconomyService = require(Server.EconomyService)

local ReportService = {}

local REGION_SET: { [string]: boolean } = {}
for _, region in ipairs(Config.Reports.Regions) do
	REGION_SET[region] = true
end

local function totalRelicPower(profile: Types.Profile): number
	local total = 0
	for _, relic in pairs(profile.relics) do
		total += relic.power
	end
	return total
end

function ReportService.collect(player: Player, profile: Types.Profile, region: string)
	if not Guard.consume(player, "report", Config.Limits.MaxReportsPerMinute) then
		return false, "Too many reports. The scribe needs a breath."
	end

	if not Guard.isStringId(region, 32) then
		return false, "Malformed region."
	end
	if not REGION_SET[region] then
		return false, "No such region on the map."
	end

	if profile.energy < Config.Ludus.MissionEnergyCost then
		return false, "Not enough energy. Rest, and the Path restores you."
	end
	if #profile.reports >= Config.Reports.MaxHeld then
		return false, "Your satchel is full. Submit your reports first."
	end

	local now = os.time()
	profile.energy -= Config.Ludus.MissionEnergyCost

	local powerBonus = totalRelicPower(profile) * Config.Reports.YieldPerRelicPower
	local value = math.floor(Config.Reports.BaseYield + powerBonus + math.random() * 2)

	local uid = ("rpt_%d_%d"):format(now, math.random(1, 1_000_000))
	table.insert(profile.reports, {
		uid = uid,
		region = region,
		value = value,
		createdAt = now,
	})
	profile.stats.reportsCollected += 1

	EconomyService.credit(profile, Config.Currency.Soft, value, "report:" .. region, player.UserId)

	return true, {
		uid = uid,
		region = region,
		value = value,
		reportsHeld = #profile.reports,
	}
end

function ReportService.submit(player: Player, profile: Types.Profile)
	if #profile.reports == 0 then
		return false, "Nothing to submit."
	end

	local count = #profile.reports
	local totalValue = 0
	for _, report in ipairs(profile.reports) do
		totalValue += report.value
	end

	local bonus = math.floor(totalValue * Config.Reports.SubmitBonusMultiplier)
	local laurels = math.max(1, math.floor(count / 5) * Config.Reports.LaurelsPerFiveReports)

	profile.reports = {}
	EconomyService.credit(profile, Config.Currency.Soft, bonus, "submit_bonus", player.UserId)
	EconomyService.credit(profile, Config.Currency.Seasonal, laurels, "submit_laurels", player.UserId)

	return true, {
		submitted = count,
		bonus = bonus,
		laurels = laurels,
	}
end

return ReportService
