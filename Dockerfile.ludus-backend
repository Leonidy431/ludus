FROM node:18-alpine

LABEL maintainer="Ludus Backend Team"
LABEL description="Ludus Backend API - ROV Telemetry & Attribute Mapping"
LABEL version="0.1"

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init curl tini

# Copy package files
COPY functions/package*.json ./

# Install production dependencies only
RUN npm ci --production && \
    npm cache clean --force

# Copy compiled Cloud Functions (requires npm run build)
COPY functions/lib ./lib

# Copy Firestore configuration
COPY firestore.rules ./
COPY firebase.json ./

# Create health check script
RUN echo '#!/bin/sh' > /healthcheck.sh && \
    echo 'curl -f http://localhost:3000/health || exit 1' >> /healthcheck.sh && \
    chmod +x /healthcheck.sh

# Run as the image's own non-root user: node:18-alpine already has
# "node" with uid/gid 1000, so creating "ludus" with the same ids failed
# the build (addgroup: gid '1000' in use).
RUN chown -R node:node /app

USER node

# Expose port (VPC-internal only, see docker-compose)
EXPOSE 3000

# Use dumb-init to handle signals properly
ENTRYPOINT ["/sbin/dumb-init", "--"]

# Start Ludus backend API: lib/server.js listens on PORT (lib/index.js
# only exports Cloud Functions and never listened; backend 3.0, P1).
CMD ["node", "lib/server.js"]

# Health check verification
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD /healthcheck.sh || exit 1
